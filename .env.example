# Populated automatically when you run `vercel env pull .env.local`
# after attaching a Vercel Postgres (Neon) database to your project.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# Any long random string — used to sign admin login session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
